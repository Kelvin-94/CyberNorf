# Local-only PostgreSQL credentials for the bundled development container.
# Replace these values with managed secrets in any shared or deployed environment.
DATABASE_URL="postgresql://cybernorf:cybernorf@localhost:5432/cybernorf?schema=public"
POSTGRES_HOST_PORT=5432

# Better Auth session signing and encryption key.
# Generate with: openssl rand -base64 48
# Never commit a real value; rotating it invalidates all existing sessions.
BETTER_AUTH_SECRET="replace-with-a-long-random-value"

# Public origin of the application. Better Auth uses it for cookies, the
# trusted-origin check on mutations, and generated callback URLs.
BETTER_AUTH_URL="http://localhost:3000"

# Database used by the test suite. tests/helpers/database.ts refuses to run
# against any URL that does not contain "test", so keep the suffix.
# DATABASE_URL="postgresql://cybernorf:cybernorf@127.0.0.1:5432/cybernorf_test?schema=public"
# NODE_ENV="test"
#
# The test suite reads .env.test (gitignored) through --env-file-if-exists.
# Create it with the two values above, then run:
#   npm run test:db:prepare   # creates/applies migrations on the test database
#   npm test
