# Local-only PostgreSQL credentials for the bundled development container.
# Replace these values with managed secrets in any shared or deployed environment.
DATABASE_URL="postgresql://cybernorf:cybernorf@localhost:5432/cybernorf?schema=public"
POSTGRES_HOST_PORT=5432

# Better Auth session signing and encryption key.
# Generate with: openssl rand -base64 48
# Never commit a real value; rotating it invalidates all existing sessions.
BETTER_AUTH_SECRET="replace-with-a-long-random-value"

# Public origin of the application. Better Auth uses it for cookies, the
# trusted-origin check on mutations, and generated callback URLs.
# A production build requires https:// here unless the host is loopback.
BETTER_AUTH_URL="http://localhost:3000"

# Scheduler credential for the alert sweep. The platform ships no background
# worker, so a cron job or systemd timer calls GET /api/cron/notifications
# with "Authorization: Bearer $CRON_SECRET". Unset means the route answers 503
# and nothing is swept, queued, or retried. Generate it with
# openssl rand -base64 32 and set it in the deployment environment, never here:
#   CRON_SECRET=...   (at least 24 characters)

# Alert destinations must resolve to a public address by default. Set this to
# true only when the webhook receiver is an internal collector you control.
# NOTIFY_ALLOW_PRIVATE_WEBHOOKS="false"

# Agent run submissions are signed with a key derived from the agent token.
# A signature is always verified when one is present; set this to true to refuse
# unsigned submissions as well, once every monitored host signs its reports.
# AGENT_REQUIRE_SIGNED_RUNS="false"

# Optional OpenID Connect single sign-on. Setting all three of OIDC_ISSUER,
# OIDC_CLIENT_ID and OIDC_CLIENT_SECRET adds "Continue with …" to the sign-in
# page; setting only some of them refuses to start instead of silently falling
# back to passwords. Password sign-in keeps working either way.
# The issuer must be https (plain http is only accepted on loopback) and is used
# to fetch <issuer>/.well-known/openid-configuration.
# Register <BETTER_AUTH_URL>/api/auth/callback/oidc as the redirect URI at the
# identity provider.
# OIDC_ISSUER="https://idp.example.com"
# OIDC_CLIENT_ID="cybernorf"
# OIDC_CLIENT_SECRET=""
# OIDC_DISPLAY_NAME="Acme SSO"
# Set only when the redirect URI reached by the browser differs from
# BETTER_AUTH_URL (for example an extra proxy in front of the app):
# OIDC_REDIRECT_URI="https://cybernorf.example.com/api/auth/callback/oidc"

# Remote databases must be reached over TLS in production, for example:
# DATABASE_URL="postgresql://user:password@db.example.com:5432/cybernorf?schema=public&sslmode=verify-full"

# Database used by the test suite. tests/helpers/database.ts refuses to run
# against any URL that does not contain "test", so keep the suffix.
# DATABASE_URL="postgresql://cybernorf:cybernorf@127.0.0.1:5432/cybernorf_test?schema=public"
# NODE_ENV="test"
#
# The test suite reads .env.test (gitignored) through --env-file-if-exists.
# Create it with the two values above, then run:
#   npm run test:db:prepare   # creates/applies migrations on the test database
#   npm test
