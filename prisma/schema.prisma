generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Subscription tier. Tier eligibility is evaluated by the policy layer; it is
/// never treated as authorization to act on a target.
enum SubscriptionTier {
  COMMUNITY
  STUDENT
  PROFESSIONAL
  ENTERPRISE
}

/// Organization-scoped role. Capability mapping lives in src/server/authz/roles.ts.
enum OrgRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

/// What an inventory identity represents. HUMAN identities are people (linked to
/// a platform account when one exists); every other value is a non-human
/// workload, device or service credential. The identity inventory is separate
/// from Better Auth: a person can be recorded before they are invited, and a
/// device never becomes a console user.
enum IdentityKind {
  HUMAN
  MACHINE
}

enum IdentityType {
  USER
  SERVICE_ACCOUNT
  MONITORING_AGENT
  API_CLIENT
  SERVER
  NETWORK_DEVICE
  IOT_DEVICE
  CONTAINER
  OTHER
}

/// Inventory lifecycle. MACHINE identities must be ACTIVE to authenticate.
/// DEPROVISIONED is terminal for both kinds.
enum IdentityStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEPROVISIONED
}

/// How the record entered the inventory. Connector-driven sources (SCIM, OIDC,
/// agent discovery) are deliberately absent until such a connector exists.
enum IdentitySource {
  MANUAL
  IMPORT
}

enum IdentityCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Append-only identity history. Kept separate from the organization audit chain
/// so the inventory can show an object-level timeline without duplicating the
/// compliance record.
enum IdentityEventType {
  CREATED
  UPDATED
  OWNER_ASSIGNED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  SUSPENDED
  REACTIVATED
  DEPROVISIONED
  CREDENTIAL_ISSUED
  CREDENTIAL_REVOKED
  ACCESS_REVOKED
}

/// A review snapshots active memberships when it is created. There is no DRAFT
/// state: a saved review is already actionable and has a due date.
enum AccessReviewStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AccessReviewDecision {
  PENDING
  RETAIN
  REVOKE
}

enum AssetType {
  DOMAIN
  IP_ADDRESS
  CIDR
  HOSTNAME
  WEB_APPLICATION
  CLOUD_ACCOUNT
  OTHER
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

/// Ownership verification state. v1 records an operator declaration only; no
/// DNS or IAM ownership proof has been implemented yet.
enum AssetVerificationStatus {
  DECLARED
  VERIFIED
  REVOKED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

enum FindingSource {
  MANUAL
  IMPORT
  /// Produced by an approved monitoring agent run.
  AGENT
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

/// Attestation state for one framework control inside a tenant.
///
/// Only IMPLEMENTED and PARTIAL count as positive posture; NOT_APPLICABLE is
/// excluded from the score instead of counting as a pass.
enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  PARTIAL
  IMPLEMENTED
  NOT_APPLICABLE
}

/// What a piece of control evidence points at. Exactly one target is set; a
/// CHECK constraint in the migration enforces it independently of the app.
enum EvidenceKind {
  FINDING
  INCIDENT
  ASSET
  REFERENCE
  FILE
}

/// Result of the last attempt to re-hash a stored artifact. UNVERIFIED means it
/// has been written but not re-read, which is the state right after upload.
enum EvidenceIntegrity {
  UNVERIFIED
  INTACT
  MISMATCH
  MISSING
}

/// Kind of indicator of compromise. Values are normalised before storage, so a
/// domain is lower-case and a hash is lower-case hex; see domain/indicators.ts.
enum IndicatorType {
  IPV4
  IPV6
  DOMAIN
  URL
  SHA256
  MD5
  EMAIL
}

enum IndicatorStatus {
  ACTIVE
  EXPIRED
  FALSE_POSITIVE
}

/// How the value came to be known. MANUAL is an operator typing it in; IMPORT
/// is a feed or file, which is why provenance columns are mandatory for both.
enum IndicatorSourceKind {
  MANUAL
  IMPORT
}

/// OBSERVED means the indicator was seen in telemetry; REFERENCED means it is
/// merely cited by the linked record. Keeping them apart stops a citation from
/// reading as a sighting during an investigation.
enum IndicatorRelation {
  OBSERVED
  REFERENCED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum AuditActorType {
  USER
  SYSTEM
  /// An approved monitoring agent acting with its own scoped token.
  AGENT
}

/// Where an agent comes from. BUILTIN is the first-party offline monitor;
/// every other value records an external vendor or a custom integration that
/// was connected by an operator and approved by the organization owner.
enum AgentSource {
  BUILTIN
  OPENAI
  ANTHROPIC
  CUSTOM
  OTHER
}

/// Agent lifecycle. Only ACTIVE agents can authenticate; PENDING_APPROVAL,
/// SUSPENDED and REVOKED agents are rejected at the token resolver.
enum AgentStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Outcome of one monitoring run, derived server-side from the reported
/// checks: every check skipped is FAILED, a partial set is PARTIAL.
enum AgentRunStatus {
  COMPLETED
  PARTIAL
  FAILED
}

/// Transport for an alert destination. Webhooks are the only transport in this
/// release; email requires an SMTP dependency the platform does not ship.
enum NotificationChannelKind {
  WEBHOOK
}

/// What happened that is worth telling an operator about.
enum NotificationEventType {
  AGENT_OFFLINE
  AGENT_RECOVERED
  TEST
}

/// Delivery state of one queued alert. FAILED is terminal after the retry
/// budget is spent; the attempt history is kept for diagnosis.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity (managed by Better Auth; schema generated with @better-auth/cli)
// ---------------------------------------------------------------------------

model User {
  id                      String                        @id
  name                    String
  email                   String
  emailVerified           Boolean                       @default(false)
  image                   String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  twoFactorEnabled        Boolean?                      @default(false)
  sessions                Session[]
  accounts                Account[]
  twofactors              TwoFactor[]
  memberships             Membership[]
  createdAssets           Asset[]                       @relation("AssetCreatedBy")
  createdFindings         Finding[]                     @relation("FindingCreatedBy")
  assignedFindings        Finding[]                     @relation("FindingAssignedTo")
  createdIncidents        Incident[]                    @relation("IncidentCreatedBy")
  assignedIncidents       Incident[]                    @relation("IncidentAssignedTo")
  incidentNotes           IncidentNote[]
  auditEvents             AuditEvent[]
  authEvents              AuthEvent[]
  ownedControls           OrganizationControl[]         @relation("ControlOwner")
  updatedControls         OrganizationControl[]         @relation("ControlUpdatedBy")
  controlEvidence         ControlEvidence[]             @relation("EvidenceCreatedBy")
  adoptedFrameworks       OrganizationFramework[]       @relation("FrameworkAdoptedBy")
  createdAgents           Agent[]                       @relation("AgentCreatedBy")
  approvedAgents          Agent[]                       @relation("AgentApprovedBy")
  createdCheckMaps        CheckControlMap[]             @relation("CheckMapCreatedBy")
  createdChannels         NotificationChannel[]         @relation("NotificationChannelCreatedBy")
  createdAdvisories       Advisory[]                    @relation("AdvisoryCreatedBy")
  apiKeys                 UserApiKey[]
  createdIdentities       Identity[]                    @relation("IdentityCreatedBy")
  ownedIdentities         Identity[]                    @relation("IdentityOwner")
  linkedIdentities        Identity[]                    @relation("IdentityLinkedUser")
  approvedIdentities      Identity[]                    @relation("IdentityApprovedBy")
  identityEvents          IdentityEvent[]               @relation("IdentityEventActor")
  identityCredentials     IdentityCredential[]          @relation("IdentityCredentialCreatedBy")
  createdAccessReviews    AccessReview[]                @relation("AccessReviewCreatedBy")
  accessReviewDecisions   AccessReviewItem[]            @relation("AccessReviewDecidedBy")
  createdIndicators       Indicator[]                   @relation("IndicatorCreatedBy")
  createdIndicatorLinks   IndicatorLink[]               @relation("IndicatorLinkCreatedBy")
  createdEngagements      Engagement[]                  @relation("EngagementCreatedBy")
  createdScopeEntries     EngagementScopeEntry[]        @relation("ScopeEntryCreatedBy")
  requestedAuthorizations EngagementAuthorization[]     @relation("AuthorizationRequestedBy")
  decidedAuthorizations   EngagementAuthorization[]     @relation("AuthorizationDecidedBy")
  revokedAuthorizations   EngagementAuthorization[]     @relation("AuthorizationRevokedBy")
  createdExecutionWorkers ExecutionWorker[]             @relation("ExecutionWorkerCreatedBy")
  requestedExecutionJobs  ExecutionJob[]                @relation("ExecutionJobRequestedBy")
  reviewedExecutionJobs   ExecutionJob[]                @relation("ExecutionJobReviewedBy")
  cancelledExecutionJobs  ExecutionJob[]                @relation("ExecutionJobCancelledBy")
  executionEvents         ExecutionJobEvent[]           @relation("ExecutionEventActor")
  retentionPolicies       OrganizationRetentionPolicy[] @relation("RetentionPolicyUpdatedBy")
  reviewedAccessReviews   AccessReview[]                @relation("AccessReviewReviewer")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Tenant and domain model
// ---------------------------------------------------------------------------

model Organization {
  id                   String                       @id @default(cuid())
  name                 String
  slug                 String                       @unique
  description          String?
  tier                 SubscriptionTier             @default(PROFESSIONAL)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  memberships          Membership[]
  assets               Asset[]
  findings             Finding[]
  incidents            Incident[]
  auditEvents          AuditEvent[]
  frameworks           OrganizationFramework[]
  controls             OrganizationControl[]
  evidence             ControlEvidence[]
  agents               Agent[]
  agentRuns            AgentRun[]
  checkMaps            CheckControlMap[]
  notificationChannels NotificationChannel[]
  notificationEvents   NotificationEvent[]
  advisories           Advisory[]
  softwareItems        SoftwareItem[]
  apiKeys              UserApiKey[]
  identities           Identity[]
  identityCredentials  IdentityCredential[]
  identityEvents       IdentityEvent[]
  accessReviews        AccessReview[]
  accessReviewItems    AccessReviewItem[]
  indicators           Indicator[]
  indicatorLinks       IndicatorLink[]
  quota                OrganizationQuota?
  engagements          Engagement[]
  engagementScope      EngagementScopeEntry[]
  authorizations       EngagementAuthorization[]
  executionWorkers     ExecutionWorker[]
  executionJobs        ExecutionJob[]
  executionEvents      ExecutionJobEvent[]
  retentionPolicy      OrganizationRetentionPolicy?
  devices              Device[]
  devicePostureReports DevicePostureReport[]
  policyRules          PolicyRule[]
  policyDecisions      PolicyDecision[]
  networkConnectors    NetworkConnector[]
  networkSegments      NetworkSegment[]
  networkFlows         NetworkFlow[]
  networkDetections    NetworkDetection[]
  enforcementActions   EnforcementAction[]
  softwareReleases     SoftwareRelease[]
  deviceUpdates        DeviceUpdate[]

  @@map("organizations")
}

model Membership {
  id             String             @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  status         MembershipStatus   @default(ACTIVE)
  // Free-form facts (department, cost centre, employment type) that policy
  // conditions can require. They are set by an administrator, never by the
  // subject, so a decision never trusts a value the caller supplied.
  attributes     Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewItems    AccessReviewItem[]

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Asset {
  id                 String                  @id @default(cuid())
  organizationId     String
  name               String
  type               AssetType
  identifier         String
  description        String?
  criticality        AssetCriticality        @default(MEDIUM)
  status             AssetStatus             @default(ACTIVE)
  verificationStatus AssetVerificationStatus @default(DECLARED)
  createdById        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User                    @relation("AssetCreatedBy", fields: [createdById], references: [id])
  findings           Finding[]
  controlEvidence    ControlEvidence[]
  softwareItems      SoftwareItem[]

  @@unique([organizationId, identifier])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("assets")
}

model Finding {
  id              String            @id @default(cuid())
  organizationId  String
  assetId         String?
  incidentId      String?
  agentId         String?
  title           String
  description     String?
  severity        FindingSeverity
  status          FindingStatus     @default(OPEN)
  source          FindingSource
  fingerprint     String
  cveId           String?
  cvssScore       Decimal?          @db.Decimal(3, 1)
  /// Deterministic 0–100 prioritisation score (see src/server/domain/risk.ts).
  riskScore       Int               @default(0)
  /// Remediation deadline derived from severity and firstSeenAt.
  dueAt           DateTime?
  remediation     String?
  createdById     String
  assignedToId    String?
  firstSeenAt     DateTime          @default(now())
  lastSeenAt      DateTime          @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset           Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  incident        Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdBy       User              @relation("FindingCreatedBy", fields: [createdById], references: [id])
  assignedTo      User?             @relation("FindingAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  agent           Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  controlEvidence ControlEvidence[]
  indicatorLinks  IndicatorLink[]

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, assetId])
  @@index([organizationId, agentId])
  @@index([organizationId, riskScore])
  @@index([organizationId, dueAt])
  @@map("findings")
}

model Incident {
  id              String            @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  severity        IncidentSeverity
  status          IncidentStatus    @default(OPEN)
  createdById     String
  assignedToId    String?
  detectedAt      DateTime          @default(now())
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  assignedTo      User?             @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           IncidentNote[]
  findings        Finding[]
  controlEvidence ControlEvidence[]
  indicatorLinks  IndicatorLink[]

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@map("incidents")
}

model IncidentNote {
  id             String   @id @default(cuid())
  organizationId String
  incidentId     String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author         User     @relation(fields: [authorId], references: [id])

  @@index([incidentId, createdAt])
  @@index([organizationId])
  @@map("incident_notes")
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

/// Global catalog of compliance frameworks. The rows are a curated subset of
/// each standard that ships with CyberNorf, not the complete standard text; the
/// catalog is seeded by a migration and is identical for every tenant.
model Framework {
  id          String                  @id
  code        String                  @unique
  name        String
  version     String
  description String?
  controls    FrameworkControl[]
  adoptions   OrganizationFramework[]

  @@map("frameworks")
}

model FrameworkControl {
  id                   String                @id
  frameworkId          String
  code                 String
  title                String
  description          String?
  category             String?
  /// Relative weight in the posture score; 1 means an ordinary control.
  weight               Int                   @default(1)
  /// Display order inside the framework, so the catalog reads like the standard.
  position             Int                   @default(0)
  framework            Framework             @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  organizationControls OrganizationControl[]

  @@unique([frameworkId, code])
  @@index([frameworkId, category])
  @@index([frameworkId, position])
  @@map("framework_controls")
}

/// One tenant's adoption of a catalog framework. Withdrawing the adoption
/// removes the control attestations and evidence, so the unique pair keeps a
/// single active adoption per framework.
model OrganizationFramework {
  id             String                @id @default(cuid())
  organizationId String
  frameworkId    String
  adoptedById    String?
  adoptedAt      DateTime              @default(now())
  targetDate     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework      Framework             @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  adoptedBy      User?                 @relation("FrameworkAdoptedBy", fields: [adoptedById], references: [id], onDelete: SetNull)
  controls       OrganizationControl[]

  @@unique([organizationId, frameworkId])
  @@index([organizationId])
  @@map("organization_frameworks")
}

model OrganizationControl {
  id                      String                @id @default(cuid())
  organizationId          String
  organizationFrameworkId String
  controlId               String
  status                  ControlStatus         @default(NOT_STARTED)
  ownerId                 String?
  updatedById             String?
  notes                   String?
  lastReviewedAt          DateTime?
  nextReviewAt            DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationFramework   OrganizationFramework @relation(fields: [organizationFrameworkId], references: [id], onDelete: Cascade)
  control                 FrameworkControl      @relation(fields: [controlId], references: [id], onDelete: Restrict)
  owner                   User?                 @relation("ControlOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  updatedBy               User?                 @relation("ControlUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  evidence                ControlEvidence[]
  checkMaps               CheckControlMap[]

  @@unique([organizationFrameworkId, controlId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("organization_controls")
}

/// Audit-grade evidence attached to a control. Exactly one of findingId,
/// incidentId, assetId or reference is set, enforced by a CHECK constraint.
model ControlEvidence {
  id                    String              @id @default(cuid())
  organizationId        String
  organizationControlId String
  kind                  EvidenceKind
  findingId             String?
  incidentId            String?
  assetId               String?
  reference             String?
  note                  String?
  createdById           String
  createdAt             DateTime            @default(now())
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl   OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  finding               Finding?            @relation(fields: [findingId], references: [id], onDelete: Cascade)
  incident              Incident?           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  asset                 Asset?              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy             User                @relation("EvidenceCreatedBy", fields: [createdById], references: [id])

  /// File-backed evidence. `blobKey` is relative to EVIDENCE_DIR and is never
  /// built from user input, only from the generated evidence id. `sha256` is
  /// computed while streaming the upload, and `integrityStatus` records the
  /// last time the stored bytes were re-read and compared.
  fileName           String?
  contentType        String?
  sizeBytes          Int?
  sha256             String?
  blobKey            String?
  /// When the artifact was produced, as stated by the uploader. Distinct from
  /// createdAt, which is when it reached the platform.
  capturedAt         DateTime?
  integrityStatus    EvidenceIntegrity @default(UNVERIFIED)
  integrityCheckedAt DateTime?

  @@index([organizationControlId, createdAt])
  @@index([organizationId])
  /// Supports the integrity sweep, which looks for artifacts that have never
  /// been re-read or that failed verification.
  @@index([organizationId, integrityStatus])
  @@map("control_evidence")
}

/// Operator-declared link between one monitoring check and one control in an
/// adopted framework. When an agent reports the check as failing, the resulting
/// finding is attached to the mapped control as evidence, so technical
/// telemetry becomes audit evidence without anyone re-typing it.
model CheckControlMap {
  id                    String              @id @default(cuid())
  organizationId        String
  /// Check id exactly as the agent reports it, e.g. "access.host-firewall".
  checkId               String
  organizationControlId String
  createdById           String
  createdAt             DateTime            @default(now())
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl   OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  createdBy             User                @relation("CheckMapCreatedBy", fields: [createdById], references: [id])

  @@unique([organizationId, checkId, organizationControlId])
  @@index([organizationId, checkId])
  @@index([organizationControlId])
  @@map("check_control_maps")
}

// ---------------------------------------------------------------------------
// Identity inventory and access recertification
// ---------------------------------------------------------------------------

/// Tenant-scoped inventory of human and non-human identities. This is the
/// governance record, not the authentication store: Better Auth owns console
/// users, while this row records what exists, who owns it and whether it should
/// still exist. `identifier` is canonicalized (trimmed, lower-cased) so
/// `svc-backup` and `SVC-BACKUP` cannot become two inventory entries.
model Identity {
  id                String               @id @default(cuid())
  organizationId    String
  kind              IdentityKind
  type              IdentityType
  displayName       String
  identifier        String
  description       String?
  department        String?
  criticality       IdentityCriticality  @default(MEDIUM)
  status            IdentityStatus       @default(ACTIVE)
  source            IdentitySource       @default(MANUAL)
  /// Scopes granted to machine credentials. Human identities keep this empty.
  approvedScopes    String[]             @default([])
  /// Accountable person for a non-human identity; optional for humans, where
  /// `department` is the governance grouping.
  ownerUserId       String?
  /// Set only for HUMAN identities that correspond to a platform account.
  linkedUserId      String?
  /// Machine credential lifetime applied to newly issued credentials.
  credentialTtlDays Int                  @default(90)
  lastSeenAt        DateTime?
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  suspendedAt       DateTime?
  deprovisionedAt   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User?                @relation("IdentityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  linkedUser        User?                @relation("IdentityLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdBy         User                 @relation("IdentityCreatedBy", fields: [createdById], references: [id])
  approvedBy        User?                @relation("IdentityApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  credentials       IdentityCredential[]
  events            IdentityEvent[]

  @@unique([organizationId, identifier])
  @@index([organizationId, kind, status])
  @@index([organizationId, type])
  @@index([organizationId, linkedUserId])
  @@index([organizationId, ownerUserId])
  @@map("identities")
}

/// Scoped bearer credential for a non-human identity. Only a SHA-256 hash and a
/// short display prefix are stored; the plaintext is returned once at issue
/// time. Rotation issues a new row and revokes the old one, so credential
/// history survives.
model IdentityCredential {
  id             String       @id @default(cuid())
  organizationId String
  identityId     String
  name           String
  keyHash        String       @unique
  keyPrefix      String
  scopes         String[]     @default([])
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("IdentityCredentialCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, identityId])
  @@index([identityId, revokedAt])
  @@index([organizationId, expiresAt])
  @@map("identity_credentials")
}

/// Append-only object history for one identity. A database trigger rejects
/// UPDATE and DELETE, matching the audit trail's integrity rule.
model IdentityEvent {
  id             String            @id @default(cuid())
  organizationId String
  identityId     String
  type           IdentityEventType
  actorId        String?
  summary        String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       Identity          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  actor          User?             @relation("IdentityEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([identityId, createdAt])
  @@map("identity_events")
}

/// One recertification campaign. Items snapshot the memberships that existed at
/// creation, so a membership added mid-review is not silently approved by a
/// campaign that never considered it.
model AccessReview {
  id             String             @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         AccessReviewStatus @default(ACTIVE)
  dueAt          DateTime
  createdById    String
  reviewerId     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  completedAt    DateTime?
  cancelledAt    DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User               @relation("AccessReviewCreatedBy", fields: [createdById], references: [id])
  reviewer       User?              @relation("AccessReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  items          AccessReviewItem[]

  @@index([organizationId, status])
  @@index([organizationId, dueAt])
  @@map("access_reviews")
}

/// One membership under review, with a governance snapshot of the member. The
/// decision is bound to an authenticated reviewer; `RETAIN` is an explicit
/// affirmative record, not the absence of a revocation.
model AccessReviewItem {
  id             String               @id @default(cuid())
  organizationId String
  reviewId       String
  membershipId   String
  userId         String
  userName       String
  userEmail      String
  roleAtReview   OrgRole
  decision       AccessReviewDecision @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  note           String?
  createdAt      DateTime             @default(now())
  review         AccessReview         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  decidedBy      User?                @relation("AccessReviewDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, membershipId])
  @@index([organizationId, reviewId, decision])
  @@index([decidedById])
  @@map("access_review_items")
}

// ---------------------------------------------------------------------------
// Agents (offline monitoring and owner-approved external agents)
// ---------------------------------------------------------------------------

/// A monitoring agent bound to one organization. The bearer token is stored as
/// a SHA-256 hash plus a short display prefix, so a database reader cannot
/// recover a usable credential; the plaintext is shown once at registration
/// (builtin agents) or approval (every external source).
model Agent {
  id                      String         @id @default(cuid())
  organizationId          String
  name                    String
  description             String?
  source                  AgentSource
  status                  AgentStatus    @default(PENDING_APPROVAL)
  /// Granted scopes from the agent scope catalog; enforced per request.
  scopes                  String[]       @default([])
  tokenHash               String?        @unique
  tokenPrefix             String?
  tokenExpiresAt          DateTime?
  lastSeenAt              DateTime?
  lastRunAt               DateTime?
  /// Operator expectation for reporting cadence. When set, a missed window is
  /// reported as STALE and a doubled one as OFFLINE and queued as an alert.
  expectedIntervalMinutes Int?
  /// When an offline alert was last queued, so one outage alerts once and a
  /// recovery clears the marker.
  offlineNotifiedAt       DateTime?
  runCount                Int            @default(0)
  createdById             String
  approvedById            String?
  approvedAt              DateTime?
  revokedAt               DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy               User           @relation("AgentCreatedBy", fields: [createdById], references: [id])
  approvedBy              User?          @relation("AgentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  runs                    AgentRun[]
  findings                Finding[]
  softwareItems           SoftwareItem[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, status, lastRunAt])
  @@map("agents")
}

/// One monitoring run reported by an agent. Counts and status are derived
/// server-side from the submitted checks; the raw check list is kept so the
/// console can show what the agent actually observed.
model AgentRun {
  id                String         @id @default(cuid())
  organizationId    String
  agentId           String
  status            AgentRunStatus
  hostname          String?
  platform          String?
  startedAt         DateTime
  finishedAt        DateTime?
  durationMs        Int?
  checkCount        Int            @default(0)
  passCount         Int            @default(0)
  failCount         Int            @default(0)
  skipCount         Int            @default(0)
  findingsCreated   Int            @default(0)
  findingsRefreshed Int            @default(0)
  checks            Json
  createdAt         DateTime       @default(now())
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent             Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([agentId, startedAt])
  @@map("agent_runs")
}

/// Where alerts are delivered: an HTTPS endpoint the operator controls, plus
/// the HMAC secret used to sign each delivery. The secret is stored sealed with
/// AES-256-GCM under a key derived from BETTER_AUTH_SECRET, never in clear text.
model NotificationChannel {
  id              String                  @id @default(cuid())
  organizationId  String
  name            String
  kind            NotificationChannelKind @default(WEBHOOK)
  url             String
  secretSealed    String
  enabled         Boolean                 @default(true)
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lastDeliveredAt DateTime?
  lastError       String?
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("NotificationChannelCreatedBy", fields: [createdById], references: [id])
  events          NotificationEvent[]

  @@unique([organizationId, name])
  @@index([organizationId, enabled])
  @@map("notification_channels")
}

/// Outbox row for one alert to one channel. Queued in the same transaction as
/// the condition that caused it, delivered by the cron sweep, and retried with
/// exponential backoff. dedupeKey makes a repeated sweep idempotent.
model NotificationEvent {
  id             String                @id @default(cuid())
  organizationId String
  channelId      String
  type           NotificationEventType
  payload        Json
  status         NotificationStatus    @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  deliveredAt    DateTime?
  lastError      String?
  dedupeKey      String?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("notification_events")
}

/// Append-only audit trail. A database trigger rejects UPDATE and DELETE on
/// this table; rows are hash-chained per organization for tamper evidence.
model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String
  sequence       Int
  actorType      AuditActorType
  actorId        String?
  action         String
  outcome        AuditOutcome
  targetType     String?
  targetId       String?
  summary        String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  prevHash       String?
  hash           String
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sequence])
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, targetType, targetId])
  @@map("audit_events")
}

/// Authentication and second-factor activity. These rows are deliberately
/// separate from `AuditEvent`: sign-in happens before any tenant is known, and
/// the per-organization hash chain must not absorb pre-tenant activity. Rows
/// are append-only in practice; a database trigger rejects update and delete.
model AuthEvent {
  id        String       @id @default(cuid())
  /// Null when the attempt did not resolve to an account (for example, a
  /// password sign-in for an address that does not exist).
  userId    String?
  action    String
  outcome   AuditOutcome
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("auth_events")
}

/// Personal API key for the console API. The credential belongs to one user
/// and is bound to one organization, so it can never read another tenant even
/// if the owner is a member of several. Only the SHA-256 hash is stored; the
/// plaintext value is shown once at creation.
model UserApiKey {
  id             String       @id @default(cuid())
  name           String
  keyHash        String       @unique
  keyPrefix      String
  userId         String
  organizationId String
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@index([organizationId])
  @@map("user_api_keys")
}

/// Fixed-window counters for CyberNorf API rate limits (Better Auth keeps its
/// own counters in the RateLimit table).
model ApiRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@map("api_rate_limits")
}

// ---------------------------------------------------------------------------
// Software inventory and vulnerability advisories
// ---------------------------------------------------------------------------

/// Package ecosystem (and, for operating systems, the package manager) that an
/// inventory item or an advisory belongs to. Agents tag what they collect with
/// one of these values, so matching never relies on naming conventions between
/// an agent and the platform.
enum PackageEcosystem {
  /// Debian/Ubuntu packages reported by dpkg-query.
  APT
  /// Red Hat family packages reported by rpm.
  RPM
  /// Homebrew formulae and casks.
  BREW
  /// npm global packages.
  NPM
  /// Python packages from pip.
  PYPI
  GO
  CARGO
  RUBYGEMS
  MAVEN
  NUGET
  OTHER
}

/// One advisory the operator imported (CVE, GHSA, vendor bulletin). The platform
/// never fetches these itself: keeping the fleet offline means the advisory feed
/// is imported on the operator's schedule from a source they trust.
model Advisory {
  id             String           @id @default(cuid())
  organizationId String
  /// Advisory identifier as published, e.g. "CVE-2024-3094" or "GHSA-xxxx".
  identifier     String
  packageName    String
  ecosystem      PackageEcosystem
  summary        String
  severity       FindingSeverity
  /// Version range expression evaluated by src/server/domain/versions.ts,
  /// e.g. ">= 3.0.0, < 3.0.7" or "^1.2.3".
  affectedRange  String
  fixedVersion   String?
  cvssScore      Decimal?         @db.Decimal(3, 1)
  referenceUrl   String?
  publishedAt    DateTime?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("AdvisoryCreatedBy", fields: [createdById], references: [id])

  /// One advisory can name several packages; each package is its own row.
  @@unique([organizationId, identifier, packageName])
  @@index([organizationId, ecosystem, packageName])
  @@index([organizationId, identifier])
  @@map("advisories")
}

/// A package observed on a host by the last successful agent run. The set is a
/// snapshot: the run that reports it replaces the previous one so the table
/// stays bounded and a removed package disappears instead of lingering.
model SoftwareItem {
  id             String           @id @default(cuid())
  organizationId String
  agentId        String
  /// Host asset the package was found on, resolved from the run hostname.
  assetId        String?
  ecosystem      PackageEcosystem
  name           String
  version        String
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  asset          Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([agentId, ecosystem, name])
  @@index([organizationId, ecosystem, name])
  @@index([organizationId, assetId])
  @@map("software_items")
}

// ---------------------------------------------------------------------------
// Indicators of compromise
// ---------------------------------------------------------------------------

/// One indicator of compromise, with the provenance needed to defend it in an
/// investigation: where it came from, when it was first and last seen, and who
/// recorded it. `value` is stored normalised (see domain/indicators.ts) so the
/// same indicator imported twice from different feeds is one row, not two.
model Indicator {
  id             String              @id @default(cuid())
  organizationId String
  type           IndicatorType
  /// Normalised form: lower-case domain/url/hash/email, canonical IP.
  value          String
  /// How the operator should read it, preserved from the source: the original
  /// spelling of a URL or the case of a domain as published.
  displayValue   String?
  status         IndicatorStatus     @default(ACTIVE)
  /// 0-100. Confidence is the provider's judgement, not ours.
  confidence     Int                 @default(50)
  sourceKind     IndicatorSourceKind @default(MANUAL)
  /// Name of the feed, report or person that supplied the value.
  sourceName     String
  sourceUrl      String?
  /// Identifier inside the source, e.g. a report or case number.
  sourceRef      String?
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  expiresAt      DateTime?
  note           String?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("IndicatorCreatedBy", fields: [createdById], references: [id])
  links          IndicatorLink[]

  /// Also serves lookups by (organizationId, type, value); a separate index on
  /// the same columns would be dead weight that every write has to maintain.
  @@unique([organizationId, type, value])
  @@index([organizationId, status, lastSeenAt])
  @@map("indicators")
}

/// Link from an indicator to the record that cites or observed it. Exactly one
/// of findingId and incidentId is set; the migration adds a CHECK constraint and
/// two partial unique indexes, because a plain unique index treats NULLs as
/// distinct and would allow the same pair twice.
model IndicatorLink {
  id             String            @id @default(cuid())
  organizationId String
  indicatorId    String
  findingId      String?
  incidentId     String?
  relation       IndicatorRelation @default(REFERENCED)
  note           String?
  createdById    String
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  indicator      Indicator         @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  finding        Finding?          @relation(fields: [findingId], references: [id], onDelete: Cascade)
  incident       Incident?         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("IndicatorLinkCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, indicatorId])
  @@index([findingId])
  @@index([incidentId])
  @@map("indicator_links")
}

// ---------------------------------------------------------------------------
// Deployment-level state
// ---------------------------------------------------------------------------

/// Key/value state for the installation as a whole, never for one tenant. Used
/// to record what this deployment has already applied — currently the
/// fingerprint of the effective configuration — so a change is visible after
/// the fact even though the process environment itself is not auditable.
/// Values are always non-secret derived data (a keyed digest), never an
/// environment value.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Resource quotas
// ---------------------------------------------------------------------------

/// Per-organization override of the tier defaults in domain/quotas.ts. A NULL
/// column means "use the tier default"; a non-null value replaces it. Storage
/// is expressed in megabytes so the column stays a plain Int and cannot
/// overflow a 32-bit integer in practice.
model OrganizationQuota {
  organizationId    String       @id
  assets            Int?
  findings          Int?
  incidents         Int?
  identities        Int?
  agents            Int?
  indicators        Int?
  apiKeys           Int?
  evidenceStorageMb Int?
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_quotas")
}

// ---------------------------------------------------------------------------
// Engagements, authorized testing scope and controlled execution (Phase 4)
// ---------------------------------------------------------------------------

/// Lifecycle of an authorized testing engagement. Only an ACTIVE engagement can
/// dispatch a job; DRAFT exists so scope and authorization can be prepared
/// before anything is executable, and CLOSED is terminal.
enum EngagementStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

/// An inclusion grants coverage; an exclusion removes it even when a broader
/// inclusion also matches. Exclusions are evaluated first.
enum ScopeEntryKind {
  INCLUDE
  EXCLUDE
}

/// How a scope value is interpreted. DOMAIN covers the exact host and its
/// subdomains; URL pins scheme, host and port; CIDR covers address ranges.
enum ScopeTargetType {
  DOMAIN
  IP_ADDRESS
  CIDR
  URL
}

enum AuthorizationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// Capabilities a worker may execute. Each maps to a fixed risk level in
/// src/server/domain/execution.ts; a job cannot lower its own risk.
enum ExecutionCapability {
  DNS_LOOKUP
  HTTP_PROBE
  TLS_INSPECTION
  PORT_SCAN
}

enum ExecutionRisk {
  LOW
  MEDIUM
  HIGH
}

/// PENDING_REVIEW exists so a high-risk request is durable before a human sees
/// it. DENIED is the terminal record of a request that never ran.
enum ExecutionJobStatus {
  PENDING_REVIEW
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DENIED
}

enum ExecutionReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ExecutionWorkerStatus {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum ExecutionEventType {
  REQUESTED
  REVIEW_REQUESTED
  REVIEW_APPROVED
  REVIEW_REJECTED
  DISPATCH_DENIED
  EXECUTION_DENIED
  QUEUED
  STARTED
  COMPLETED
  FAILED
  CANCELLED
}

/// A bounded period of testing against an explicitly listed set of targets.
/// The engagement is the unit an authorizer approves: it carries the window,
/// the scope entries, and the authorization records that allow dispatch.
model Engagement {
  id             String                    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         EngagementStatus          @default(DRAFT)
  startsAt       DateTime
  endsAt         DateTime
  closedAt       DateTime?
  createdById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                      @relation("EngagementCreatedBy", fields: [createdById], references: [id])
  scopeEntries   EngagementScopeEntry[]
  authorizations EngagementAuthorization[]
  jobs           ExecutionJob[]

  @@unique([organizationId, name])
  @@index([organizationId, status, endsAt])
  @@map("engagements")
}

/// One target rule. The value is normalized on write (lowercase host, canonical
/// CIDR, URL with default port) so matching never depends on how it was typed.
model EngagementScopeEntry {
  id             String          @id @default(cuid())
  organizationId String
  engagementId   String
  kind           ScopeEntryKind
  targetType     ScopeTargetType
  value          String
  note           String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  engagement     Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ScopeEntryCreatedBy", fields: [createdById], references: [id])

  @@unique([engagementId, kind, targetType, value])
  @@index([organizationId])
  @@map("engagement_scope_entries")
}

/// The authorization to test. `expiresAt` is mandatory and is checked on every
/// dispatch and every execution start; an engagement window that outlives the
/// authorization cannot extend it. At most one APPROVED record per engagement
/// is enforced by the service inside a row lock.
model EngagementAuthorization {
  id             String              @id @default(cuid())
  organizationId String
  engagementId   String
  status         AuthorizationStatus @default(PENDING)
  reference      String?
  conditions     String?
  requestedById  String
  decidedById    String?
  decidedAt      DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  engagement     Engagement          @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  requestedBy    User                @relation("AuthorizationRequestedBy", fields: [requestedById], references: [id])
  decidedBy      User?               @relation("AuthorizationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  revokedBy      User?               @relation("AuthorizationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  jobs           ExecutionJob[]

  @@index([engagementId, status])
  @@index([organizationId, expiresAt])
  @@map("engagement_authorizations")
}

/// An execution worker registered by the organization. A worker is only
/// eligible when it reports isolation, has a non-empty egress allowlist, and
/// has a recent heartbeat. The allowlist is enforced at dispatch: a worker that
/// cannot reach the target is not a candidate.
model ExecutionWorker {
  id              String                @id @default(cuid())
  organizationId  String
  name            String
  status          ExecutionWorkerStatus @default(ACTIVE)
  isolated        Boolean               @default(false)
  egressAllowlist String[]
  attestationRef  String?
  lastHeartbeatAt DateTime?
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("ExecutionWorkerCreatedBy", fields: [createdById], references: [id])
  jobs            ExecutionJob[]

  @@unique([organizationId, name])
  @@index([organizationId, status, lastHeartbeatAt])
  @@map("execution_workers")
}

/// A request to run one capability against one target. `approvedAddresses` is
/// the DNS answer observed at dispatch; the start path resolves again and
/// refuses to run when the answer changed, which is how a DNS rebind between
/// approval and execution is caught.
model ExecutionJob {
  id                String                  @id @default(cuid())
  organizationId    String
  engagementId      String
  authorizationId   String
  workerId          String?
  capability        ExecutionCapability
  targetType        ScopeTargetType
  targetValue       String
  requestedById     String
  risk              ExecutionRisk
  reviewStatus      ExecutionReviewStatus   @default(NOT_REQUIRED)
  reviewedById      String?
  reviewedAt        DateTime?
  status            ExecutionJobStatus      @default(QUEUED)
  approvedAddresses String[]
  limits            Json
  denialReason      String?
  cancelRequestedAt DateTime?
  cancelledById     String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  engagement        Engagement              @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  authorization     EngagementAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  worker            ExecutionWorker?        @relation(fields: [workerId], references: [id], onDelete: SetNull)
  requestedBy       User                    @relation("ExecutionJobRequestedBy", fields: [requestedById], references: [id])
  reviewedBy        User?                   @relation("ExecutionJobReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  cancelledBy       User?                   @relation("ExecutionJobCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  events            ExecutionJobEvent[]

  @@index([organizationId, status, createdAt])
  @@index([engagementId, status])
  @@index([workerId, status])
  @@map("execution_jobs")
}

/// Append-only job timeline. It records denials as first-class events, so an
/// out-of-scope request leaves the same durable trace as one that ran.
model ExecutionJobEvent {
  id             String             @id @default(cuid())
  organizationId String
  jobId          String
  type           ExecutionEventType
  message        String
  metadata       Json?
  actorId        String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            ExecutionJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor          User?              @relation("ExecutionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([organizationId, createdAt])
  @@map("execution_job_events")
}

// ---------------------------------------------------------------------------
// Tenant-configurable retention (Phase 5)
// ---------------------------------------------------------------------------

/// Per-tenant retention for derived operational history. Business records
/// (findings, incidents, assets, compliance evidence) and the append-only audit
/// chain are deliberately absent: neither is removed by a timer.
model OrganizationRetentionPolicy {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  agentRunDays          Int          @default(90)
  notificationEventDays Int          @default(90)
  softwareItemDays      Int          @default(180)
  executionJobDays      Int          @default(180)
  updatedById           String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy             User         @relation("RetentionPolicyUpdatedBy", fields: [updatedById], references: [id])

  @@map("organization_retention_policies")
}

// ---------------------------------------------------------------------------
// Zero Trust control plane
//
// Devices, posture, policy decisions, network observations, enforcement and
// update distribution. Every record is tenant-scoped, and every mutating path
// writes an audit event in the same transaction as the change.
// ---------------------------------------------------------------------------

enum DeviceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
}

/// UNTRUSTED ranks below UNKNOWN on purpose: a device that failed a signature
/// or posture check is worse than one that has simply never reported.
enum DeviceTrustState {
  UNTRUSTED
  UNKNOWN
  PARTIAL
  TRUSTED
}

enum PolicySubjectKind {
  USER
  DEVICE
  IDENTITY
}

enum PolicyEffect {
  ALLOW
  DENY
  STEP_UP
  QUARANTINE
}

/// Ordered from least to most sensitive. Policy conditions compare against a
/// minimum, so the order is part of the contract and is asserted by tests.
enum ResourceSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum NetworkConnectorKind {
  RADIUS
  GATEWAY
  FIREWALL
  EDR
  SWITCH
}

enum ConnectorStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

/// Behaviour when the connector cannot be reached. CLOSED quarantines; OPEN
/// lets the stored policy decide but records the unreachable connector.
enum ConnectorFailMode {
  CLOSED
  OPEN
}

enum NetworkZone {
  CORPORATE
  GUEST
  OT
  QUARANTINE
  EXTERNAL
}

enum DetectionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DetectionStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum EnforcementKind {
  SESSION_REVOKE
  ENDPOINT_ISOLATE
  NETWORK_QUARANTINE
  FIREWALL_BLOCK
  CERT_REVOKE
}

enum EnforcementState {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
  ACKNOWLEDGED
  VERIFIED
  FAILED
  EXPIRED
}

enum ReleaseStatus {
  DRAFT
  CANARY
  ROLLING
  RELEASED
  ROLLED_BACK
}

enum DeviceUpdateState {
  OFFERED
  DOWNLOADING
  INSTALLING
  INSTALLED
  FAILED
  ROLLED_BACK
}

/// A device the organization has enrolled. `publicKey` is the key the device
/// proves possession of when it submits posture; posture reports that do not
/// verify against it are recorded as unverified and cannot raise trust.
model Device {
  id                  String                @id @default(cuid())
  organizationId      String
  name                String
  hardwareId          String
  publicKey           String
  keyAlgorithm        String                @default("ed25519")
  attestationKind     String                @default("NONE")
  attestationVerified Boolean               @default(false)
  managed             Boolean               @default(false)
  os                  String?
  osVersion           String?
  status              DeviceStatus          @default(PENDING)
  trustState          DeviceTrustState      @default(UNKNOWN)
  trustScore          Int                   @default(0)
  ownerUserId         String?
  lastSeenAt          DateTime?
  createdById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postureReports      DevicePostureReport[]
  updates             DeviceUpdate[]

  @@unique([organizationId, hardwareId])
  @@index([organizationId, trustState])
  @@index([organizationId, status])
  @@map("devices")
}

/// One posture collection. `checks` is a JSON array of
/// `{ id, status: PASS|FAIL|UNKNOWN, detail }`. `signature` covers the canonical
/// serialization of `{ deviceId, collectedAt, checks }`.
model DevicePostureReport {
  id                String       @id @default(cuid())
  organizationId    String
  deviceId          String
  collectedAt       DateTime
  expiresAt         DateTime
  signature         String?
  signatureVerified Boolean      @default(false)
  checks            Json
  source            String       @default("AGENT")
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device            Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, collectedAt])
  @@index([organizationId, expiresAt])
  @@map("device_posture_reports")
}

/// An ordered rule. Rules are evaluated in ascending `priority`; the first rule
/// whose every declared condition passes decides the verdict. When nothing
/// matches, the decision point denies.
model PolicyRule {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  priority       Int          @default(100)
  effect         PolicyEffect
  enabled        Boolean      @default(true)
  conditions     Json
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, enabled, priority])
  @@map("policy_rules")
}

/// The recorded verdict. Facts are stored with the decision so an auditor can
/// see what the decision point actually knew, not what the caller claimed.
model PolicyDecision {
  id                  String              @id @default(cuid())
  organizationId      String
  correlationId       String
  subjectKind         PolicySubjectKind
  subjectId           String
  subjectLabel        String
  resourceType        String
  resourceId          String?
  resourceSensitivity ResourceSensitivity
  action              String
  verdict             PolicyEffect
  riskScore           Int
  matchedRuleId       String?
  requestContext      Json
  facts               Json
  explanation         Json
  createdAt           DateTime            @default(now())
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, verdict, createdAt])
  @@index([organizationId, subjectKind, subjectId, createdAt])
  @@map("policy_decisions")
}

/// A RADIUS server, gateway, firewall, EDR or switch that supplies observations
/// or accepts enforcement commands. `tokenHash` authenticates the connector.
model NetworkConnector {
  id              String               @id @default(cuid())
  organizationId  String
  name            String
  kind            NetworkConnectorKind
  endpointUrl     String?
  tokenHash       String
  status          ConnectorStatus      @default(OFFLINE)
  failMode        ConnectorFailMode    @default(CLOSED)
  capabilities    String[]             @default([])
  lastHeartbeatAt DateTime?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segments        NetworkSegment[]
  flows           NetworkFlow[]
  actions         EnforcementAction[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("network_connectors")
}

/// A named address range with a zone and a sensitivity. Admission decisions and
/// detections read these instead of trusting a caller-supplied zone.
model NetworkSegment {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  cidr           String
  zone           NetworkZone
  sensitivity    ResourceSensitivity @default(INTERNAL)
  connectorId    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector      NetworkConnector?   @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  flows          NetworkFlow[]

  @@unique([organizationId, name])
  @@index([organizationId, zone])
  @@map("network_segments")
}

/// One observed conversation. Ingest is bounded per request; the row is the
/// evidence a detection points at.
model NetworkFlow {
  id                 String            @id @default(cuid())
  organizationId     String
  connectorId        String?
  sourceAddress      String
  sourcePort         Int?
  destinationAddress String
  destinationPort    Int?
  protocol           String
  bytes              Int               @default(0)
  observedAt         DateTime
  deviceId           String?
  segmentId          String?
  createdAt          DateTime          @default(now())
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector          NetworkConnector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  segment            NetworkSegment?   @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, observedAt])
  @@index([organizationId, sourceAddress, observedAt])
  @@map("network_flows")
}

/// A detection produced by an ingestion batch. `observations` stores the flow
/// ids and the facts that triggered it, so an alert can explain itself.
model NetworkDetection {
  id             String            @id @default(cuid())
  organizationId String
  ruleKey        String
  subjectKey     String
  title          String
  description    String
  severity       DetectionSeverity
  status         DetectionStatus   @default(OPEN)
  deviceId       String?
  observations   Json
  freshUntil     DateTime
  firstSeenAt    DateTime          @default(now())
  lastSeenAt     DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ruleKey, subjectKey])
  @@index([organizationId, status, severity])
  @@index([organizationId, lastSeenAt])
  @@map("network_detections")
}

/// A command to a connector. `idempotencyKey` makes a retry return the original
/// action instead of sending twice. Destructive kinds need a second approver.
model EnforcementAction {
  id             String            @id @default(cuid())
  organizationId String
  kind           EnforcementKind
  targetType     String
  targetId       String
  targetLabel    String
  connectorId    String?
  payload        Json
  idempotencyKey String
  state          EnforcementState  @default(REQUESTED)
  /// Why the operator asked for the command. Never approved silently.
  reason         String?
  /// A request that is not approved in time expires instead of staying armed.
  expiresAt      DateTime?
  requestedById  String
  approvedById   String?
  rejectedReason String?
  dispatchedAt   DateTime?
  acknowledgedAt DateTime?
  verifiedAt     DateTime?
  failureReason  String?
  result         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector      NetworkConnector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, state, createdAt])
  @@map("enforcement_actions")
}

/// A published artifact. The manifest is signed by a publisher key the
/// operator holds outside the database; `minVersion` is the anti-rollback floor.
model SoftwareRelease {
  id                String         @id @default(cuid())
  organizationId    String
  product           String
  version           String
  channel           String         @default("stable")
  artifactUrl       String
  sha256            String
  manifest          Json
  manifestSignature String
  publisherKeyId    String
  minVersion        String?
  compatibility     Json
  status            ReleaseStatus  @default(DRAFT)
  canaryPercent     Int            @default(0)
  createdById       String?
  releasedAt        DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updates           DeviceUpdate[]

  @@unique([organizationId, product, version])
  @@index([organizationId, product, status])
  @@map("software_releases")
}

/// Per-device progress against one release. The unique pair makes an offer
/// idempotent and gives rollback a single row to update.
model DeviceUpdate {
  id             String            @id @default(cuid())
  organizationId String
  deviceId       String
  releaseId      String
  state          DeviceUpdateState @default(OFFERED)
  offeredAt      DateTime          @default(now())
  installedAt    DateTime?
  failedAt       DateTime?
  result         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device         Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  release        SoftwareRelease   @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([deviceId, releaseId])
  @@index([organizationId, state])
  @@map("device_updates")
}
