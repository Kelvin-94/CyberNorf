generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Subscription tier. Tier eligibility is evaluated by the policy layer; it is
/// never treated as authorization to act on a target.
enum SubscriptionTier {
  COMMUNITY
  STUDENT
  PROFESSIONAL
  ENTERPRISE
}

/// Organization-scoped role. Capability mapping lives in src/server/authz/roles.ts.
enum OrgRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum AssetType {
  DOMAIN
  IP_ADDRESS
  CIDR
  HOSTNAME
  WEB_APPLICATION
  CLOUD_ACCOUNT
  OTHER
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

/// Ownership verification state. v1 records an operator declaration only; no
/// DNS or IAM ownership proof has been implemented yet.
enum AssetVerificationStatus {
  DECLARED
  VERIFIED
  REVOKED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

enum FindingSource {
  MANUAL
  IMPORT
  /// Produced by an approved monitoring agent run.
  AGENT
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

/// Attestation state for one framework control inside a tenant.
///
/// Only IMPLEMENTED and PARTIAL count as positive posture; NOT_APPLICABLE is
/// excluded from the score instead of counting as a pass.
enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  PARTIAL
  IMPLEMENTED
  NOT_APPLICABLE
}

/// What a piece of control evidence points at. Exactly one target is set; a
/// CHECK constraint in the migration enforces it independently of the app.
enum EvidenceKind {
  FINDING
  INCIDENT
  ASSET
  REFERENCE
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum AuditActorType {
  USER
  SYSTEM
  /// An approved monitoring agent acting with its own scoped token.
  AGENT
}

/// Where an agent comes from. BUILTIN is the first-party offline monitor;
/// every other value records an external vendor or a custom integration that
/// was connected by an operator and approved by the organization owner.
enum AgentSource {
  BUILTIN
  OPENAI
  ANTHROPIC
  CUSTOM
  OTHER
}

/// Agent lifecycle. Only ACTIVE agents can authenticate; PENDING_APPROVAL,
/// SUSPENDED and REVOKED agents are rejected at the token resolver.
enum AgentStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Outcome of one monitoring run, derived server-side from the reported
/// checks: every check skipped is FAILED, a partial set is PARTIAL.
enum AgentRunStatus {
  COMPLETED
  PARTIAL
  FAILED
}

/// Transport for an alert destination. Webhooks are the only transport in this
/// release; email requires an SMTP dependency the platform does not ship.
enum NotificationChannelKind {
  WEBHOOK
}

/// What happened that is worth telling an operator about.
enum NotificationEventType {
  AGENT_OFFLINE
  AGENT_RECOVERED
  TEST
}

/// Delivery state of one queued alert. FAILED is terminal after the retry
/// budget is spent; the attempt history is kept for diagnosis.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity (managed by Better Auth; schema generated with @better-auth/cli)
// ---------------------------------------------------------------------------

model User {
  id                String                  @id
  name              String
  email             String
  emailVerified     Boolean                 @default(false)
  image             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  twoFactorEnabled  Boolean?                @default(false)
  sessions          Session[]
  accounts          Account[]
  twofactors        TwoFactor[]
  memberships       Membership[]
  createdAssets     Asset[]                 @relation("AssetCreatedBy")
  createdFindings   Finding[]               @relation("FindingCreatedBy")
  assignedFindings  Finding[]               @relation("FindingAssignedTo")
  createdIncidents  Incident[]              @relation("IncidentCreatedBy")
  assignedIncidents Incident[]              @relation("IncidentAssignedTo")
  incidentNotes     IncidentNote[]
  auditEvents       AuditEvent[]
  ownedControls     OrganizationControl[]   @relation("ControlOwner")
  updatedControls   OrganizationControl[]   @relation("ControlUpdatedBy")
  controlEvidence   ControlEvidence[]       @relation("EvidenceCreatedBy")
  adoptedFrameworks OrganizationFramework[] @relation("FrameworkAdoptedBy")
  createdAgents     Agent[]                 @relation("AgentCreatedBy")
  approvedAgents    Agent[]                 @relation("AgentApprovedBy")
  createdCheckMaps  CheckControlMap[]       @relation("CheckMapCreatedBy")
  createdChannels   NotificationChannel[]   @relation("NotificationChannelCreatedBy")
  createdAdvisories Advisory[]              @relation("AdvisoryCreatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Tenant and domain model
// ---------------------------------------------------------------------------

model Organization {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  description          String?
  tier                 SubscriptionTier        @default(PROFESSIONAL)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  memberships          Membership[]
  assets               Asset[]
  findings             Finding[]
  incidents            Incident[]
  auditEvents          AuditEvent[]
  frameworks           OrganizationFramework[]
  controls             OrganizationControl[]
  evidence             ControlEvidence[]
  agents               Agent[]
  agentRuns            AgentRun[]
  checkMaps            CheckControlMap[]
  notificationChannels NotificationChannel[]
  notificationEvents   NotificationEvent[]
  advisories           Advisory[]
  softwareItems        SoftwareItem[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Asset {
  id                 String                  @id @default(cuid())
  organizationId     String
  name               String
  type               AssetType
  identifier         String
  description        String?
  criticality        AssetCriticality        @default(MEDIUM)
  status             AssetStatus             @default(ACTIVE)
  verificationStatus AssetVerificationStatus @default(DECLARED)
  createdById        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User                    @relation("AssetCreatedBy", fields: [createdById], references: [id])
  findings           Finding[]
  controlEvidence    ControlEvidence[]
  softwareItems      SoftwareItem[]

  @@unique([organizationId, identifier])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("assets")
}

model Finding {
  id              String            @id @default(cuid())
  organizationId  String
  assetId         String?
  incidentId      String?
  agentId         String?
  title           String
  description     String?
  severity        FindingSeverity
  status          FindingStatus     @default(OPEN)
  source          FindingSource
  fingerprint     String
  cveId           String?
  cvssScore       Decimal?          @db.Decimal(3, 1)
  remediation     String?
  createdById     String
  assignedToId    String?
  firstSeenAt     DateTime          @default(now())
  lastSeenAt      DateTime          @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset           Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  incident        Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdBy       User              @relation("FindingCreatedBy", fields: [createdById], references: [id])
  assignedTo      User?             @relation("FindingAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  agent           Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  controlEvidence ControlEvidence[]

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, assetId])
  @@index([organizationId, agentId])
  @@map("findings")
}

model Incident {
  id              String            @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  severity        IncidentSeverity
  status          IncidentStatus    @default(OPEN)
  createdById     String
  assignedToId    String?
  detectedAt      DateTime          @default(now())
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  assignedTo      User?             @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           IncidentNote[]
  findings        Finding[]
  controlEvidence ControlEvidence[]

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@map("incidents")
}

model IncidentNote {
  id             String   @id @default(cuid())
  organizationId String
  incidentId     String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author         User     @relation(fields: [authorId], references: [id])

  @@index([incidentId, createdAt])
  @@index([organizationId])
  @@map("incident_notes")
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

/// Global catalog of compliance frameworks. The rows are a curated subset of
/// each standard that ships with CyberNorf, not the complete standard text; the
/// catalog is seeded by a migration and is identical for every tenant.
model Framework {
  id          String                  @id
  code        String                  @unique
  name        String
  version     String
  description String?
  controls    FrameworkControl[]
  adoptions   OrganizationFramework[]

  @@map("frameworks")
}

model FrameworkControl {
  id                   String                @id
  frameworkId          String
  code                 String
  title                String
  description          String?
  category             String?
  /// Relative weight in the posture score; 1 means an ordinary control.
  weight               Int                   @default(1)
  /// Display order inside the framework, so the catalog reads like the standard.
  position             Int                   @default(0)
  framework            Framework             @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  organizationControls OrganizationControl[]

  @@unique([frameworkId, code])
  @@index([frameworkId, category])
  @@index([frameworkId, position])
  @@map("framework_controls")
}

/// One tenant's adoption of a catalog framework. Withdrawing the adoption
/// removes the control attestations and evidence, so the unique pair keeps a
/// single active adoption per framework.
model OrganizationFramework {
  id             String                @id @default(cuid())
  organizationId String
  frameworkId    String
  adoptedById    String?
  adoptedAt      DateTime              @default(now())
  targetDate     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework      Framework             @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  adoptedBy      User?                 @relation("FrameworkAdoptedBy", fields: [adoptedById], references: [id], onDelete: SetNull)
  controls       OrganizationControl[]

  @@unique([organizationId, frameworkId])
  @@index([organizationId])
  @@map("organization_frameworks")
}

model OrganizationControl {
  id                      String                @id @default(cuid())
  organizationId          String
  organizationFrameworkId String
  controlId               String
  status                  ControlStatus         @default(NOT_STARTED)
  ownerId                 String?
  updatedById             String?
  notes                   String?
  lastReviewedAt          DateTime?
  nextReviewAt            DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationFramework   OrganizationFramework @relation(fields: [organizationFrameworkId], references: [id], onDelete: Cascade)
  control                 FrameworkControl      @relation(fields: [controlId], references: [id], onDelete: Restrict)
  owner                   User?                 @relation("ControlOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  updatedBy               User?                 @relation("ControlUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  evidence                ControlEvidence[]
  checkMaps               CheckControlMap[]

  @@unique([organizationFrameworkId, controlId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("organization_controls")
}

/// Audit-grade evidence attached to a control. Exactly one of findingId,
/// incidentId, assetId or reference is set, enforced by a CHECK constraint.
model ControlEvidence {
  id                    String              @id @default(cuid())
  organizationId        String
  organizationControlId String
  kind                  EvidenceKind
  findingId             String?
  incidentId            String?
  assetId               String?
  reference             String?
  note                  String?
  createdById           String
  createdAt             DateTime            @default(now())
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl   OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  finding               Finding?            @relation(fields: [findingId], references: [id], onDelete: Cascade)
  incident              Incident?           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  asset                 Asset?              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy             User                @relation("EvidenceCreatedBy", fields: [createdById], references: [id])

  @@index([organizationControlId, createdAt])
  @@index([organizationId])
  @@map("control_evidence")
}

/// Operator-declared link between one monitoring check and one control in an
/// adopted framework. When an agent reports the check as failing, the resulting
/// finding is attached to the mapped control as evidence, so technical
/// telemetry becomes audit evidence without anyone re-typing it.
model CheckControlMap {
  id                    String              @id @default(cuid())
  organizationId        String
  /// Check id exactly as the agent reports it, e.g. "access.host-firewall".
  checkId               String
  organizationControlId String
  createdById           String
  createdAt             DateTime            @default(now())
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl   OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  createdBy             User                @relation("CheckMapCreatedBy", fields: [createdById], references: [id])

  @@unique([organizationId, checkId, organizationControlId])
  @@index([organizationId, checkId])
  @@index([organizationControlId])
  @@map("check_control_maps")
}

// ---------------------------------------------------------------------------
// Agents (offline monitoring and owner-approved external agents)
// ---------------------------------------------------------------------------

/// A monitoring agent bound to one organization. The bearer token is stored as
/// a SHA-256 hash plus a short display prefix, so a database reader cannot
/// recover a usable credential; the plaintext is shown once at registration
/// (builtin agents) or approval (every external source).
model Agent {
  id                      String         @id @default(cuid())
  organizationId          String
  name                    String
  description             String?
  source                  AgentSource
  status                  AgentStatus    @default(PENDING_APPROVAL)
  /// Granted scopes from the agent scope catalog; enforced per request.
  scopes                  String[]       @default([])
  tokenHash               String?        @unique
  tokenPrefix             String?
  tokenExpiresAt          DateTime?
  lastSeenAt              DateTime?
  lastRunAt               DateTime?
  /// Operator expectation for reporting cadence. When set, a missed window is
  /// reported as STALE and a doubled one as OFFLINE and queued as an alert.
  expectedIntervalMinutes Int?
  /// When an offline alert was last queued, so one outage alerts once and a
  /// recovery clears the marker.
  offlineNotifiedAt       DateTime?
  runCount                Int            @default(0)
  createdById             String
  approvedById            String?
  approvedAt              DateTime?
  revokedAt               DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy               User           @relation("AgentCreatedBy", fields: [createdById], references: [id])
  approvedBy              User?          @relation("AgentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  runs                    AgentRun[]
  findings                Finding[]
  softwareItems           SoftwareItem[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, status, lastRunAt])
  @@map("agents")
}

/// One monitoring run reported by an agent. Counts and status are derived
/// server-side from the submitted checks; the raw check list is kept so the
/// console can show what the agent actually observed.
model AgentRun {
  id                String         @id @default(cuid())
  organizationId    String
  agentId           String
  status            AgentRunStatus
  hostname          String?
  platform          String?
  startedAt         DateTime
  finishedAt        DateTime?
  durationMs        Int?
  checkCount        Int            @default(0)
  passCount         Int            @default(0)
  failCount         Int            @default(0)
  skipCount         Int            @default(0)
  findingsCreated   Int            @default(0)
  findingsRefreshed Int            @default(0)
  checks            Json
  createdAt         DateTime       @default(now())
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent             Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([agentId, startedAt])
  @@map("agent_runs")
}

/// Where alerts are delivered: an HTTPS endpoint the operator controls, plus
/// the HMAC secret used to sign each delivery. The secret is stored sealed with
/// AES-256-GCM under a key derived from BETTER_AUTH_SECRET, never in clear text.
model NotificationChannel {
  id              String                  @id @default(cuid())
  organizationId  String
  name            String
  kind            NotificationChannelKind @default(WEBHOOK)
  url             String
  secretSealed    String
  enabled         Boolean                 @default(true)
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lastDeliveredAt DateTime?
  lastError       String?
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("NotificationChannelCreatedBy", fields: [createdById], references: [id])
  events          NotificationEvent[]

  @@unique([organizationId, name])
  @@index([organizationId, enabled])
  @@map("notification_channels")
}

/// Outbox row for one alert to one channel. Queued in the same transaction as
/// the condition that caused it, delivered by the cron sweep, and retried with
/// exponential backoff. dedupeKey makes a repeated sweep idempotent.
model NotificationEvent {
  id             String                @id @default(cuid())
  organizationId String
  channelId      String
  type           NotificationEventType
  payload        Json
  status         NotificationStatus    @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  deliveredAt    DateTime?
  lastError      String?
  dedupeKey      String?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("notification_events")
}

/// Append-only audit trail. A database trigger rejects UPDATE and DELETE on
/// this table; rows are hash-chained per organization for tamper evidence.
model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String
  sequence       Int
  actorType      AuditActorType
  actorId        String?
  action         String
  outcome        AuditOutcome
  targetType     String?
  targetId       String?
  summary        String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  prevHash       String?
  hash           String
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sequence])
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, targetType, targetId])
  @@map("audit_events")
}

/// Fixed-window counters for CyberNorf API rate limits (Better Auth keeps its
/// own counters in the RateLimit table).
model ApiRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@map("api_rate_limits")
}

// ---------------------------------------------------------------------------
// Software inventory and vulnerability advisories
// ---------------------------------------------------------------------------

/// Package ecosystem (and, for operating systems, the package manager) that an
/// inventory item or an advisory belongs to. Agents tag what they collect with
/// one of these values, so matching never relies on naming conventions between
/// an agent and the platform.
enum PackageEcosystem {
  /// Debian/Ubuntu packages reported by dpkg-query.
  APT
  /// Red Hat family packages reported by rpm.
  RPM
  /// Homebrew formulae and casks.
  BREW
  /// npm global packages.
  NPM
  /// Python packages from pip.
  PYPI
  GO
  CARGO
  RUBYGEMS
  MAVEN
  NUGET
  OTHER
}

/// One advisory the operator imported (CVE, GHSA, vendor bulletin). The platform
/// never fetches these itself: keeping the fleet offline means the advisory feed
/// is imported on the operator's schedule from a source they trust.
model Advisory {
  id             String           @id @default(cuid())
  organizationId String
  /// Advisory identifier as published, e.g. "CVE-2024-3094" or "GHSA-xxxx".
  identifier     String
  packageName    String
  ecosystem      PackageEcosystem
  summary        String
  severity       FindingSeverity
  /// Version range expression evaluated by src/server/domain/versions.ts,
  /// e.g. ">= 3.0.0, < 3.0.7" or "^1.2.3".
  affectedRange  String
  fixedVersion   String?
  cvssScore      Decimal?         @db.Decimal(3, 1)
  referenceUrl   String?
  publishedAt    DateTime?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("AdvisoryCreatedBy", fields: [createdById], references: [id])

  /// One advisory can name several packages; each package is its own row.
  @@unique([organizationId, identifier, packageName])
  @@index([organizationId, ecosystem, packageName])
  @@index([organizationId, identifier])
  @@map("advisories")
}

/// A package observed on a host by the last successful agent run. The set is a
/// snapshot: the run that reports it replaces the previous one so the table
/// stays bounded and a removed package disappears instead of lingering.
model SoftwareItem {
  id             String           @id @default(cuid())
  organizationId String
  agentId        String
  /// Host asset the package was found on, resolved from the run hostname.
  assetId        String?
  ecosystem      PackageEcosystem
  name           String
  version        String
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  asset          Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([agentId, ecosystem, name])
  @@index([organizationId, ecosystem, name])
  @@index([organizationId, assetId])
  @@map("software_items")
}
