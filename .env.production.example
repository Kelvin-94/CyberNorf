# Production environment for compose.prod.yaml.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Replace every value below, then start the stack:
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build
#
# This file holds real credentials once filled in. It is gitignored and excluded
# from the Docker build context; keep it on the host, not in the repository.

# --- public identity -------------------------------------------------------
# Hostname the browser uses. It must resolve to this host publicly, because the
# proxy obtains its certificate over ACME and needs ports 80 and 443 reachable.
CYBERNORF_DOMAIN=cybernorf.example.com
# Contact address for the certificate authority. Expiry notices arrive here.
ACME_EMAIL=security@example.com

# Public origin, always https and always the same host as CYBERNORF_DOMAIN.
# The app compares it against the request origin for every state-changing call,
# so a mismatch shows up as "403 Cross-site requests are not allowed".
BETTER_AUTH_URL=https://cybernorf.example.com

# --- secrets ---------------------------------------------------------------
# Session signing and second-factor encryption. Generate with:
#   openssl rand -base64 48
# At least 32 characters; the app refuses to start otherwise. Rotating it
# invalidates every session and makes stored TOTP secrets unreadable.
BETTER_AUTH_SECRET=

# Scheduler credential for GET /api/cron/notifications. Generate with:
#   openssl rand -base64 32
# Leaving it empty disables the alert sweep (the route answers 503).
CRON_SECRET=

# Rotation helper for the three allow-listed secrets (never prints the value):
#   npm run secrets:rotate -- --name CRON_SECRET --dir /run/secrets/cybernorf --apply

# --- storage -----------------------------------------------------------------
# Uploaded control-evidence blobs live here, outside the database and outside
# the image. Must be an absolute path, must be backed up together with the
# database, and must be writable by the app user. Bind-mount the host directory
# into the app container at the same path. Unset disables file evidence: the
# upload route answers 503 and nothing else changes.
# EVIDENCE_DIR=/var/lib/cybernorf/evidence
#
# Mounted secret files (Docker/Swarm secrets, Kubernetes secret volumes, Vault
# agent templates). One file per variable, named exactly BETTER_AUTH_SECRET,
# CRON_SECRET or OIDC_CLIENT_SECRET; a file wins over the value in this file.
# SECRETS_DIR=/run/secrets/cybernorf

# --- zero trust updates ------------------------------------------------------
# Public keys whose signatures the release channel accepts, as comma-separated
# `keyId:base64` entries. Each value is an ed25519 public key in DER
# SubjectPublicKeyInfo form (a PEM key also works). These keys do not belong in
# the database: a stolen database would otherwise be enough to publish a release
# that every connector installs.
#
# Generate a signing key and print the matching entry with:
#   openssl genpkey -algorithm ED25519 -out publisher.pem
#   printf '%s:%s\n' 2026-11 "$(openssl pkey -in publisher.pem -pubout -outform DER | openssl base64 -A)"
#
# Keep publisher.pem offline and never on this host. Leaving this unset is valid
# but disables publishing: the upload refuses an unknown key id with 400, and the
# update channel reports zero configured keys.
# ZERO_TRUST_PUBLISHER_KEYS=2026-11:MCowBQYDK2VwAyEA...

# --- database --------------------------------------------------------------
# The password used when the database volume is created. Changing it later does
# not change the role password inside an existing volume.
POSTGRES_DB=cybernorf
POSTGRES_USER=cybernorf
POSTGRES_PASSWORD=

# Connection string used by the app and by the migration step. The host is the
# compose service name, and TLS is mandatory: the app refuses to start when a
# non-loopback database is named without it.
#
# The certificate is self-signed and generated on the database's first boot, so
# `sslrootcert` points at the copy that compose mounts read-only from the
# database-tls volume. With sslmode=verify-full the client checks that the
# certificate really belongs to `database` instead of merely encrypting.
#
# A managed database outside this stack: use the provider's CA bundle as
# sslrootcert and drop the database-tls mount from the app and migrate services.
DATABASE_URL=postgresql://cybernorf:REPLACE_WITH_POSTGRES_PASSWORD@database:5432/cybernorf?schema=public&sslmode=verify-full&sslrootcert=/etc/cybernorf/database-tls/server.crt

# --- behavior --------------------------------------------------------------
# Refuse unsigned agent run submissions once every monitored host signs its
# reports (the bundled monitor always signs).
AGENT_REQUIRE_SIGNED_RUNS=true
# Allow alert webhooks that resolve to private addresses. Leave false unless the
# receiver is an internal collector you control.
NOTIFY_ALLOW_PRIVATE_WEBHOOKS=false

# Image tag built by the compose file. Change it to keep several builds around
# during an upgrade; `local` is fine for a single host.
CYBERNORF_IMAGE_TAG=local

# --- single sign-on (optional) ----------------------------------------------
# Leave these commented out to keep password sign-in as the only method. Setting
# only some of OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET makes the app
# refuse to start, so a half-finished configuration cannot be mistaken for
# working SSO. The issuer must be https and is used to read
# <issuer>/.well-known/openid-configuration. Discovery is fetched when the app
# starts and retried on the next sign-in attempt when the identity provider was
# unreachable, so an outage does not need a restart; if the document publishes
# no issuer and jwks_uri the provider is never trusted and only passwords work.
#
# At the identity provider, register this redirect URI exactly:
#   ${BETTER_AUTH_URL}/api/auth/callback/oidc
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=cybernorf
# OIDC_CLIENT_SECRET=
# Label on the sign-in button; defaults to "single sign-on".
# OIDC_DISPLAY_NAME=Acme SSO
